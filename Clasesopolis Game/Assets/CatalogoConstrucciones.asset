  construcciones:
  - id: build_1
    nombre: Gato Tejada
    descripcion: "s una ic\xF3nica escultura de bronce de 3,5 metros de altura y
      3 toneladas, creada por el artista Hernando Tejada en 1996 y donada a Cali,
      Colombia"
    icono: {fileID: 21300000, guid: dd186ca06b34ff740a17eec44a2d8eac, type: 3}
