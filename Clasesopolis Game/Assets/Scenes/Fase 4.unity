    desactivarAlEntrar:
    - {fileID: 2072150639}
    animadorCamara: {fileID: 0}
    triggerCamara: 
    animadorByte: {fileID: 0}
    triggerByte: 
  - nombrePaso: Explicacion8_momento2
    mensajeTexto: "\xBFLe agarraste el tiro? basicamente una relaci\xF3n de 1:n,
      es cuando 1 sola clase, se relacione puede relacionar muchas veces con otra.\n\nComo
      vimos 1 Solo pilota maneja muchos Drones o 1 Sola clase Hotel tiene muchos
      \"Huespedes\""
    audioPaso: {fileID: 8300000, guid: 79fd3cd7cff26f9469e2a5c856fff635, type: 3}
    panelPrincipal: {fileID: 752424388}
    textoUI: {fileID: 1432824453}
    esRetoInteractivos: 0
    objetoDelReto: {fileID: 0}
    esPasoFinal: 0
    escenaDestino: 
