    animadorByte: {fileID: 0}
    triggerByte: 
  - nombrePaso: Informacion_reto
    mensajeTexto: "En el siguiente reto, se te presentar\xE1n diferentes elementos
      a superar, pero tranquilo seran faciles, ya que solamente deberas escoger 
      la opci\xF3n que consideres correcta, no te preocupes, que me puedes preguntar
      algo si lo necesitas."
    audioPaso: {fileID: 8300000, guid: 7683ebf1238f04449be05325d5b43d7d, type: 3}
