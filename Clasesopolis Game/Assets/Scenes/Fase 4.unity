    - {fileID: 2143503826}
    desactivarAlEntrar:
    - {fileID: 1525234878}
    animadorCamara: {fileID: 0}
    triggerCamara: 
    animadorByte: {fileID: 0}
    triggerByte: 
  - nombrePaso: Explicacion4_momento2
    mensajeTexto: "O tambien podriamos verlo en la ciudad: un edificio tiene una
      sola direcci\xF3n.\n"
    audioPaso: {fileID: 8300000, guid: 3c94fba950c460c4f9c4ce961fc02bb5, type: 3}
    panelPrincipal: {fileID: 752424388}
    textoUI: {fileID: 787883085}
    esRetoInteractivos: 0
    objetoDelReto: {fileID: 0}
    esPasoFinal: 0
    escenaDestino: 
    numeroFase: 1
    esCheckpoint: 0
