    triggerCamara: 
    animadorByte: {fileID: 0}
    triggerByte: 
  - nombrePaso: Explicacion9_momento2
    mensajeTexto: "N:N \u2014 muchos a muchos. Veamos que casos encontramos\n\nEjemplo
      dron: muchos drones pueden hacer entregas a muchos clientes (cada cliente recibe
      de varios drones distintos, y cada dron entrega a varios clientes). "
    audioPaso: {fileID: 8300000, guid: e73247b1ab470af4394f6e8b16cd3b5c, type: 3}
    panelPrincipal: {fileID: 752424388}
    textoUI: {fileID: 1553952852}
