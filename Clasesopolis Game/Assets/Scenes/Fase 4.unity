  pasos:
  - nombrePaso: Bienvenda
    mensajeTexto: 
    audioPaso: {fileID: 8300000, guid: dab8e1bcbf658c94484b36ad3be6d956, type: 3}
    panelPrincipal: {fileID: 752424388}
    textoUI: {fileID: 0}
    esRetoInteractivos: 0
    objetoDelReto: {fileID: 0}
    esPasoFinal: 0
    escenaDestino: 
