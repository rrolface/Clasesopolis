  - nombrePaso: Explicacion2.0_momento2
    mensajeTexto: "Ahora aprender\xE1s sobre un concepto muy relacionado a las Clases
      y son los Objetos o instancias."
    audioPaso: {fileID: 8300000, guid: 560bf5cc1c6b2ff47a43cc1e17d21709, type: 3}
