    - {fileID: 253102461}
    desactivarAlEntrar:
    - {fileID: 2143503826}
    animadorCamara: {fileID: 0}
    triggerCamara: 
    animadorByte: {fileID: 0}
    triggerByte: 
  - nombrePaso: Explicacion5_momento2
    mensajeTexto: "\xBFSi lo ves? el 1:1 es cuando solo 1 objeto se relaciona solo
      1 vez con otro. ya que como los ejemplos que vimos un Dron no puede tener 2
      n\xFAmero de serie o un edificio no podria tener 2 direcciones."
    audioPaso: {fileID: 8300000, guid: fce18014d9bdc9b4f8fcf403d2ad86b2, type: 3}
    panelPrincipal: {fileID: 752424388}
    textoUI: {fileID: 683947942}
    esRetoInteractivos: 0
    objetoDelReto: {fileID: 0}
    esPasoFinal: 0
    escenaDestino: 
    numeroFase: 1
    esCheckpoint: 0
    activarAlEntrar:
    - {fileID: 999313681}
    desactivarAlEntrar:
    - {fileID: 253102461}
    animadorCamara: {fileID: 0}
    triggerCamara: 
    animadorByte: {fileID: 0}
    triggerByte: 
  - nombrePaso: Explicacion6_momento2
    mensajeTexto: "1:N \u2014 uno a muchos. \n\nPillemos el ejemplo: un piloto controla
      muchos drones, pero cada dron tiene un solo piloto en ese momento. "
    audioPaso: {fileID: 8300000, guid: e1755c42b427c5d4f8849efebb8dc2dc, type: 3}
    panelPrincipal: {fileID: 752424388}
    textoUI: {fileID: 1200847712}
    esRetoInteractivos: 0
    objetoDelReto: {fileID: 0}
    esPasoFinal: 0
    escenaDestino: 
    numeroFase: 1
    esCheckpoint: 0
    activarAlEntrar:
    - {fileID: 2072150639}
    desactivarAlEntrar:
    - {fileID: 999313681}
    animadorCamara: {fileID: 0}
    triggerCamara: 
    animadorByte: {fileID: 0}
    triggerByte: 
  - nombrePaso: Explicacion7_momento2
    mensajeTexto: "Veamoslo desde nuestra ciudad: un hotel tiene muchos hu\xE9spedes,
      pero cada hu\xE9sped est\xE1 en un solo hotel."
    audioPaso: {fileID: 8300000, guid: c5e2f641783632f4180fa44d8d3706d2, type: 3}
    panelPrincipal: {fileID: 752424388}
    textoUI: {fileID: 1803602483}
    esRetoInteractivos: 0
    objetoDelReto: {fileID: 0}
    esPasoFinal: 0
    escenaDestino: 
    numeroFase: 1
    esCheckpoint: 0
