  - nombrePaso: Explicacion3_momento2
    mensajeTexto: "1:1 \u2014 uno a uno. \n\nPillemos otra vez el dron: un dron tiene
      un solo n\xFAmero de serie, ese n\xFAmero pertenece a un solo dron."
    audioPaso: {fileID: 8300000, guid: 63133f75eb552674ba7fd6f19dc4567d, type: 3}
    panelPrincipal: {fileID: 752424388}
    textoUI: {fileID: 274575530}
    esRetoInteractivos: 0
    objetoDelReto: {fileID: 0}
    esPasoFinal: 0
    escenaDestino: 
    numeroFase: 1
    esCheckpoint: 0
